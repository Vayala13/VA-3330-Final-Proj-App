<%- include("partials/header.ejs") %>

<p><a href="/cases">Back to cases</a></p>

<div class="page-heading">
  <h1><%= matter.caption %></h1>
  <a href="/cases/<%= matter.caseId %>/edit" class="btn">Edit case</a>
</div>

<% if (locals.saved) { %>
  <p class="alert alert-success" role="status">Case saved. The change is recorded in the history below.</p>
<% } else if (locals.unchanged) { %>
  <p class="alert alert-info" role="status">No changes to save.</p>
<% } else if (locals.deadlineAdded) { %>
  <p class="alert alert-success" role="status">Deadline added. It is recorded in the history below.</p>
<% } else if (locals.deadlineMoved) { %>
  <p class="alert alert-success" role="status">Deadline moved. The old date is kept in its history.</p>
<% } else if (locals.taskAdded) { %>
  <p class="alert alert-success" role="status">Task added. It is recorded in the history below.</p>
<% } %>

<dl class="case-facts">
  <div><dt>Status</dt><dd><%= matter.status %></dd></div>
  <div><dt>Cause number</dt><dd><%= matter.causeNumber %></dd></div>
  <div><dt>Client</dt><dd><%= matter.clientName %></dd></div>
  <div><dt>Type</dt><dd><%= matter.type %></dd></div>
  <div><dt>Lead attorney</dt><dd><%= matter.leadAttorneyName %></dd></div>
  <div><dt>Last touched</dt><dd><%= matter.lastTouchedDate %> by <%= matter.lastTouchedByName %></dd></div>
</dl>

<h2 id="deadlines">Deadlines</h2>

<% if (deadlines.length === 0) { %>
  <p class="empty">No deadlines on this case yet.</p>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr><th>Status</th><th>Due</th><th>Deadline</th><th>Kind</th><th>Owner</th><th></th></tr>
    </thead>
    <tbody>
      <% deadlines.forEach((deadline) => { %>
        <tr>
          <td class="nowrap">
            <% if (deadline.flag) { %>
              <span class="flag flag-<%= deadline.flag.toLowerCase().replace(" ", "-") %>"><%= deadline.flag %></span>
            <% } else { %>
              <span class="flag flag-done">Done <%= deadline.completedDate %></span>
            <% } %>
          </td>
          <td class="nowrap"><%= deadline.dueDate %></td>
          <td>
            <%= deadline.title %>
            <% if (deadline.history.length > 0) { %>
              <ul class="deadline-history">
                <% deadline.history.forEach((change) => { %>
                  <li>Moved from <%= change.oldDate %> to <%= change.newDate %> by <%= change.changedByName %> on <%= change.changedDate %>: <%= change.reason %></li>
                <% }) %>
              </ul>
            <% } %>
          </td>
          <td><%= deadline.kind %></td>
          <td><%= deadline.ownerName %></td>
          <td class="nowrap">
            <% if (!deadline.completedDate) { %>
              <a href="/deadlines/<%= deadline.deadlineId %>/move">Move</a>
              <%- include("partials/markDone.ejs", { markDoneAction: `/deadlines/${deadline.deadlineId}/complete`, markDoneFrom: "case" }) %>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<section class="card">
  <h3>Add a deadline</h3>

  <% if (locals.deadlineError) { %>
    <p class="alert alert-error" role="alert"><%= deadlineError %></p>
  <% } %>

  <form action="/cases/<%= matter.caseId %>/deadlines" method="POST" class="form">
    <%- include("partials/csrf.ejs") %>

    <label for="title">Title</label>
    <input type="text" id="title" name="title" maxlength="200" placeholder="Response to motion" value="<%= deadlineForm.title || "" %>" required>

    <label for="kind">Kind</label>
    <select id="kind" name="kind" required>
      <option value="">Choose a kind</option>
      <% deadlineKinds.forEach((kind) => { %>
        <option value="<%= kind %>" <%= deadlineForm.kind === kind ? "selected" : "" %>><%= kind %></option>
      <% }) %>
    </select>

    <label for="dueDate">Due date</label>
    <input type="date" id="dueDate" name="dueDate" value="<%= deadlineForm.dueDate || "" %>" required>

    <label for="ownerId">Owner</label>
    <select id="ownerId" name="ownerId" required>
      <option value="">Choose a person</option>
      <% staff.forEach((person) => { %>
        <option value="<%= person.userId %>" <%= String(deadlineForm.ownerId) === String(person.userId) ? "selected" : "" %>><%= person.name %></option>
      <% }) %>
    </select>

    <button type="submit" class="btn">Add deadline</button>
  </form>
</section>

<h2 id="tasks">Tasks</h2>

<% if (tasks.length === 0) { %>
  <p class="empty">No tasks on this case yet.</p>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr><th></th><th>Due</th><th>Task</th><th>Priority</th><th>Owner</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% tasks.forEach((task) => { %>
        <% [task, ...task.subtasks].forEach((row) => { %>
          <tr>
            <td class="nowrap">
              <% if (row.label) { %>
                <span class="flag flag-<%= row.label.toLowerCase().replace(" ", "-") %>"><%= row.label %></span>
              <% } %>
            </td>
            <td class="nowrap"><%= row.dueDate %></td>
            <td class="<%= row.parentTitle ? "subtask-row" : "" %>"><%= row.title %></td>
            <td><%= row.priority %></td>
            <td><%= row.ownerName %></td>
            <td class="nowrap"><%= row.status %></td>
            <td class="nowrap">
              <% if (!row.done) { %>
                <%- include("partials/markDone.ejs", { markDoneAction: `/tasks/${row.taskId}/complete`, markDoneFrom: "case" }) %>
              <% } %>
            </td>
          </tr>
        <% }) %>
      <% }) %>
    </tbody>
  </table>
<% } %>

<section class="card">
  <h3>Add a task</h3>

  <% if (locals.taskError) { %>
    <p class="alert alert-error" role="alert"><%= taskError %></p>
  <% } %>

  <form action="/cases/<%= matter.caseId %>/tasks" method="POST" class="form">
    <%- include("partials/csrf.ejs") %>

    <label for="taskTitle">Title</label>
    <input type="text" id="taskTitle" name="title" maxlength="200" placeholder="Motion for summary judgment" value="<%= taskForm.title || "" %>" required>

    <label for="taskDueDate">Due date</label>
    <input type="date" id="taskDueDate" name="dueDate" value="<%= taskForm.dueDate || "" %>" required>

    <label for="priority">Priority</label>
    <select id="priority" name="priority" required>
      <% priorities.forEach((priority) => { %>
        <option value="<%= priority %>" <%= taskForm.priority === priority ? "selected" : "" %>><%= priority %></option>
      <% }) %>
    </select>

    <label for="taskOwnerId">Owner</label>
    <select id="taskOwnerId" name="ownerId" required>
      <option value="">Choose a person</option>
      <% staff.forEach((person) => { %>
        <option value="<%= person.userId %>" <%= String(taskForm.ownerId) === String(person.userId) ? "selected" : "" %>><%= person.name %></option>
      <% }) %>
    </select>

    <label for="templateId">Checklist (optional)</label>
    <select id="templateId" name="templateId">
      <option value="">No checklist</option>
      <% templates.forEach((template) => { %>
        <option value="<%= template.templateId %>" <%= String(taskForm.templateId) === String(template.templateId) ? "selected" : "" %>><%= template.name %>: <%= template.subtaskTitles.join(", ") %></option>
      <% }) %>
    </select>

    <button type="submit" class="btn">Add task</button>
  </form>
</section>

<h2>History</h2>

<% if (activities.length === 0) { %>
  <p class="empty">No activity recorded yet.</p>
<% } else { %>
  <table class="data-table">
    <thead>
      <tr><th>When</th><th>Who</th><th>What</th><th>Details</th></tr>
    </thead>
    <tbody>
      <% activities.forEach((activity) => { %>
        <tr>
          <td class="nowrap"><time datetime="<%= activity.timestamp %>"><%= activity.when %></time></td>
          <td class="nowrap"><%= activity.userName %></td>
          <td class="nowrap"><%= activity.action %></td>
          <td><%= activity.detail %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include("partials/footer.ejs") %>
