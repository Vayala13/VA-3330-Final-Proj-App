<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title ? `${locals.title} | ` : "" %>MBMT Case Tracker</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/charCounter.js" defer></script>
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="brand">MBMT Case Tracker</a>
      <%- include("nav.ejs") %>
    </div>
  </header>
  <main class="container">
    <% if (locals.flash) { %>
      <p class="alert alert-<%= flash.type === "error" ? "error" : "success" %>" role="<%= flash.type === "error" ? "alert" : "status" %>"><%= flash.text %></p>
    <% } %>
